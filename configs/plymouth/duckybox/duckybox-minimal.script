# duckybox-style: minimal
#
# Duckybox Plymouth script, minimal variant: the duck mark alone, centred and
# static, over the Duckybox backdrop. No progress bar, no fade, no text. The
# animated variant with the progress bar lives in duckybox-full.script.

Window.SetBackgroundTopColor(0.110, 0.043, 0.180);    # #1C0B2E
Window.SetBackgroundBottomColor(0.071, 0.027, 0.122); # #12071F

screen_width = Window.GetWidth();
screen_height = Window.GetHeight();

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.x = screen_width / 2 - logo.image.GetWidth() / 2;
logo.y = screen_height / 2 - logo.image.GetHeight() / 2;
logo.sprite.SetX(logo.x);
logo.sprite.SetY(logo.y);
logo.sprite.SetOpacity(1);

# Disk unlock prompt, still needed on encrypted installs. It is the one thing
# allowed to appear besides the duck, because without it the boot would stall
# with no way to know a passphrase is wanted.
fun display_password_callback(prompt, bullets) {
  prompt_text.image = Image.Text(prompt, 0.93, 0.91, 1.0);
  prompt_text.sprite = Sprite(prompt_text.image);
  prompt_text.sprite.SetX(screen_width / 2 - prompt_text.image.GetWidth() / 2);
  prompt_text.sprite.SetY(logo.y + logo.image.GetHeight() + 60);

  bullet.image = Image("bullet.png");
  total_width = bullets * (bullet.image.GetWidth() + 6);
  start_x = screen_width / 2 - total_width / 2;

  for (i = 0; i < bullets; i++) {
    dot[i].sprite = Sprite(bullet.image);
    dot[i].sprite.SetX(start_x + i * (bullet.image.GetWidth() + 6));
    dot[i].sprite.SetY(logo.y + logo.image.GetHeight() + 100);
  }
}

fun display_normal_callback() {
  prompt_text.sprite = NULL;
  dot = NULL;
}

Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);
