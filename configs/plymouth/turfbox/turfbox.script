# Turfbox Plymouth script — dark bg, orange accent, fade + progress pulse

Window.SetBackgroundTopColor(0.05, 0.07, 0.09);
Window.SetBackgroundBottomColor(0.05, 0.07, 0.09);

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(Window.GetWidth() / 2 - logo.image.GetWidth() / 2);
logo.sprite.SetY(Window.GetHeight() / 2 - logo.image.GetHeight() / 2 - 40);
logo.sprite.SetOpacity(0);

bar_bg.image = Image("progress_bg.png");
bar_fg.image = Image("progress_fg.png");
bar_bg.sprite = Sprite(bar_bg.image);
bar_fg.sprite = Sprite(bar_fg.image);

bar_x = Window.GetWidth() / 2 - bar_bg.image.GetWidth() / 2;
bar_y = Window.GetHeight() / 2 + logo.image.GetHeight() / 2 + 20;
bar_bg.sprite.SetX(bar_x);
bar_bg.sprite.SetY(bar_y);
bar_fg.sprite.SetX(bar_x);
bar_fg.sprite.SetY(bar_y);
bar_fg.sprite.SetOpacity(0);

global.animation_frame = 0;
global.progress = 0.0;
global.fade = 0.0;

fun refresh_callback() {
  global.animation_frame++;

  # Fade-in logo over ~1s at 50fps
  if (global.fade < 1.0) {
    global.fade = global.animation_frame / 50.0;
    if (global.fade > 1.0) {
      global.fade = 1.0;
    }
    logo.sprite.SetOpacity(global.fade);
  }

  # Soft vertical pulse of logo after fade-in
  if (global.fade >= 1.0) {
    pulse = Math.Sin(global.animation_frame / 20.0) * 4;
    logo.sprite.SetY(Window.GetHeight() / 2 - logo.image.GetHeight() / 2 - 40 + pulse);
  }
}

fun progress_callback(duration, progress) {
  global.progress = progress;
  if (progress > 0.01) {
    bar_fg.sprite.SetOpacity(1);
    # Scale progress bar width via cropped image width approximation:
    # Plymouth script lacks clip; we approximate with opacity pulse on bar
    bar_fg.sprite.SetOpacity(0.4 + 0.6 * progress);
  }
}

Plymouth.SetRefreshFunction(refresh_callback);
Plymouth.SetBootProgressFunction(progress_callback);
